---
import "../styles/global.css";
import { logoSvg, logoDataUri } from "../lib/logo";

const features = [
	{ term: "terminal", text: "A Ghostty-powered terminal sits alongside the project context you reach for most." },
	{ term: "changes", text: "Browse diffs and Git history without stepping out of your workspace." },
	{ term: "palette", text: "Files, commands, branches, and projects, one keystroke away." },
];

const repo = "https://github.com/scmmishra/rune";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Rune is your terminal, with the context you need." />
		<title>Rune · Your terminal, with the context you need</title>
		<link rel="icon" href={logoDataUri} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
	</head>

	<body class="tube min-h-screen bg-crt-bg font-mono text-crt antialiased selection:bg-crt selection:text-crt-bg">
		<div class="retrace" aria-hidden="true"></div>

		<div class="power-on max-w-3xl px-5 py-8 text-[0.8125rem] leading-6 sm:px-10 sm:py-12 sm:leading-7">
			<header class="boot flex flex-wrap items-center gap-x-8 gap-y-3">
				<a class="flex items-center gap-2.5" href="/" aria-label="Rune home">
					<span class="block size-6 [&>svg]:size-full" aria-hidden="true" set:html={logoSvg} />
					<span class="glow-hi font-semibold text-crt-bright">rune</span>
				</a>
				<nav class="flex flex-wrap gap-x-6 gap-y-2">
					<a class="glow transition hover:text-crt-bright" href="#features">features</a>
					<a class="glow transition hover:text-crt-bright" href="#brief">brief</a>
					<a class="glow transition hover:text-crt-bright" href={repo}>source</a>
				</nav>
			</header>

			<main class="boot mt-10">
				<section>
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">NAME</h2>
					<h1 class="glow-hi mt-2 max-w-xl text-pretty text-base font-medium leading-7 text-crt-bright sm:text-xl sm:leading-8">
						rune &mdash; your terminal, with the context you need
					</h1>
				</section>

				<section class="mt-8">
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">SYNOPSIS</h2>
					<div class="mt-2 flex flex-wrap gap-x-6 gap-y-2">
						<a class="glow-hi border-b border-crt-bright/40 pb-0.5 text-crt-bright transition hover:bg-crt-bright hover:text-crt-bg" href={repo}>
							install rune
						</a>
						<a class="glow border-b border-crt/25 pb-0.5 transition hover:bg-crt hover:text-crt-bg" href={repo}>
							read the source &#8599;
						</a>
					</div>
				</section>

				<section class="mt-8">
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">DESCRIPTION</h2>
					<p class="glow mt-2 max-w-xl text-pretty">
						A small, native macOS workspace for terminal-first development.
						Keep your shell, files, diffs, and Git history close at hand.
					</p>
				</section>

				<section id="features" class="mt-8 scroll-mt-8">
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">FEATURES</h2>
					<dl class="mt-2">
						{features.map(({ term, text }) => (
							<div class="mt-2 first:mt-0 sm:flex sm:gap-6">
								<dt class="glow-hi shrink-0 text-crt-bright sm:w-24">{term}</dt>
								<dd class="glow max-w-xl text-pretty">{text}</dd>
							</div>
						))}
					</dl>
				</section>

				<section id="brief" class="mt-8 scroll-mt-8">
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">CHANGE BRIEF</h2>
					<p class="glow mt-2 max-w-xl text-pretty">
						Understand the change before you read the diff. Rune explains your
						working tree, staged changes, or pull request, and links every claim
						back to the code.
					</p>
				</section>

				<section class="mt-8">
					<h2 class="glow font-semibold tracking-[0.12em] text-crt-bright">SEE ALSO</h2>
					<p class="mt-2">
						<a class="glow border-b border-crt/25 pb-0.5 transition hover:bg-crt hover:text-crt-bg" href={repo}>
							github.com/scmmishra/rune
						</a>
					</p>
				</section>

			</main>
		</div>
	</body>
</html>
